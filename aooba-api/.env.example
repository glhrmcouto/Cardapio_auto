# Connection string do Postgres do Supabase (Project Settings > Database > Connection string).
# Use a do pooler (porta 6543) ou a direta. NUNCA commitar o .env real.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
PORT=3333
# Origens permitidas no CORS, separadas por virgula (app mobile nativo nao usa CORS; so web/dev).
CORS_ORIGINS=http://localhost:8081
